# See docs/backend/BACKEND.md for the full list of environment variables
# this backend reads (MONGO_URI, JWT_SECRET, EMAIL_KEY, GITHUB_ID/SECRET,
# GEMMA_*, ANALYSIS_*, SCAN_SCHEDULER_*, METRICS_TOKEN, etc.). This file only
# calls out the controlled-load-testing flag, since it needs a loud warning
# next to it.

# Controlled load/stress testing only.
# Disables application-level rate limiting and abuse-prevention middleware:
#   - the general per-IP HTTP rate limiter (backend/src/app.js)
#   - the auth-route rate limiter (authRateLimiter, backend/src/features/auth/router.js)
#   - the failed-sign-in lockout (assertLoginAllowed, backend/src/utils/loginAttempts.js)
# It does NOT disable authentication, authorization, input validation, CSRF
# protection, or any business-logic/data-integrity check. See docs/backend/BACKEND.md
# "Controlled Load Testing" for the complete contract.
# MUST NEVER be enabled in production — the app refuses to start if
# NODE_ENV=production and DISABLE_SEC=true.
DISABLE_SEC=false
